APP_NAME=Manba
DEBUG=false
HOST=127.0.0.1
PORT=8000
# Shared key for the optional LLM extraction step (server side only; never sent to browsers).
OPENROUTER_API_KEY=
# If this app is reachable from the internet, set an access code so only your team can spend the key.
# Clients send it in the X-Access-Token header (the test console has a Settings field for it).
API_ACCESS_TOKEN=
# Dedicated receipt signing secret (at least 32 random bytes; keep stable across deployments).
# Never reuse an access token or model API key. Without it reviews work but no badge is issued.
BADGE_SECRET=
# Chat model for claim extraction and LLM recall (default openai/gpt-4o-mini). ":free" models cost nothing but are slow
# (20-40 s per call) and rate-limited; a free model works only if the OpenRouter account's privacy settings allow it.
LLM_MODEL=
# Cheap "writer" model for the on-demand Arabic explanation (default google/gemini-2.5-flash-lite). Comma list = fallbacks.
# The judge model (LLM_MODEL) is untouched; the writer only phrases a finished result and cannot change it.
EXPLAIN_MODEL=
# Model that judges whether a text supports a claim (default google/gemini-2.5-flash: much stricter than gpt-4o-mini on claims with
# extra conditions). Comma list = fallbacks, then LLM_MODEL is tried.
JUDGE_MODEL=

# --- Free testing through Google's own API (Gemini API free tier) -----------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey and set LLM_PROVIDER=google: every model step (router, recall, triage, judge,
# explanation writer) and the embeddings then use Google. The free tier allows only a few requests per minute per model (about
# 15 for the Flash-Lite models, 5 for the Flash models), so calls are spaced automatically and a full golden run takes ~20 minutes.
# Free-tier content may be used by Google to improve its products: test with public texts, not private ones.
GEMINI_API_KEY=
LLM_PROVIDER=openrouter
# One step can use another provider: JUDGE_PROVIDER, EXPLAIN_PROVIDER, EMBED_PROVIDER (google | openrouter).
# A model name may carry its provider ("google:gemini-3.1-flash-lite", "openrouter:openai/gpt-4o-mini").
# GOOGLE_RPM=            # requests per minute per Google model (default 14 for *lite*, 4.5 otherwise; raise it on a paid key)
